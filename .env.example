# Copy to .env on a new checkout. Keep your actual values local.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:9b
# Use the Windows host address visible from WSL if localhost does not reach Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Optional credentials for experiments using other providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
