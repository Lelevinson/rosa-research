<?xml version="1.0"?>
<!-- STUDY-LOCAL objects world. LABEL: object poses read from the simulator (ground truth); simulated gripper with grasp assist; demonstration only. -->
<sdf version="1.9">
  <world name="objects_world">
    <physics name="1ms" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <gravity>0 0 -9.8</gravity>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground">
      <static>true</static>
      <link name="g"><collision name="c"><pose>0 0 -0.7 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="v"><pose>0 0 -0.7 0 0 0</pose><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link>
    </model>
    <model name="table">
      <static>true</static>
      <pose>0.55 0 -0.35 0 0 0</pose>
      <link name="table_link">
        <collision name="c"><geometry><box><size>1.0 1.2 0.70</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.2 0.70</size></box></geometry><material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="red_block">
      <pose>0.65 0.1 0.0225 0 0 0.0</pose>
      <link name="block_link">
        <inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction><contact><ode><kp>100000</kp><kd>100</kd></ode></contact></surface></collision>
        <visual name="v"><geometry><box><size>0.045 0.045 0.045</size></box></geometry>
          <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.85 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <model name="tray">
      <static>true</static>
      <pose>0.45 -0.28 0 0 0 0</pose>
      <link name="tray_link">
        <collision name="floor_c"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.24 0.18 0.01</size></box></geometry></collision>
        <visual name="floor_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.24 0.18 0.01</size></box></geometry>
          <material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material></visual>
        <collision name="wall_n_c"><pose>0 0.08399999999999999 0.025 0 0 0</pose><geometry><box><size>0.24 0.012 0.03</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>0 0.08399999999999999 0.025 0 0 0</pose><geometry><box><size>0.24 0.012 0.03</size></box></geometry>
          <material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material></visual>
        <collision name="wall_s_c"><pose>0 -0.08399999999999999 0.025 0 0 0</pose><geometry><box><size>0.24 0.012 0.03</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>0 -0.08399999999999999 0.025 0 0 0</pose><geometry><box><size>0.24 0.012 0.03</size></box></geometry>
          <material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material></visual>
        <collision name="wall_e_c"><pose>0.11399999999999999 0 0.025 0 0 0</pose><geometry><box><size>0.012 0.18 0.03</size></box></geometry></collision>
        <visual name="wall_e_v"><pose>0.11399999999999999 0 0.025 0 0 0</pose><geometry><box><size>0.012 0.18 0.03</size></box></geometry>
          <material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material></visual>
        <collision name="wall_w_c"><pose>-0.11399999999999999 0 0.025 0 0 0</pose><geometry><box><size>0.012 0.18 0.03</size></box></geometry></collision>
        <visual name="wall_w_v"><pose>-0.11399999999999999 0 0.025 0 0 0</pose><geometry><box><size>0.012 0.18 0.03</size></box></geometry>
          <material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
