<?xml version="1.0"?>
<!-- STUDY-LOCAL (objects demo, 2026-11-29). UR5e + a SIMPLE simulated parallel gripper on tool0, controlled through ros2_control (gz_ros2_control).
     LABEL - object poses read from the simulator (ground truth); simulated gripper with grasp assist; demonstration only. NOT the Robotiq 2F-85 (chosen for reliability -
     two prismatic fingers, no mimic joints). Based on the installed ur_simulation_gz/urdf/ur_gz.urdf.xacro (copied pattern; the installed file is not modified). -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro" />

  <xacro:arg name="ur_type" default="ur5e"/>
  <xacro:arg name="tf_prefix" default="" />
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>
  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="ros_namespace" default="" />

  <link name="world" />

  <xacro:ur_robot name="$(arg name)" tf_prefix="$(arg tf_prefix)" parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)" kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)" visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)" safety_pos_margin="$(arg safety_pos_margin)" safety_k_position="$(arg safety_k_position)" force_abs_paths="true">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>

  <!-- ===== simple parallel gripper on tool0 (z of tool0 points away from the flange) ===== -->
  <link name="gripper_base">
    <visual><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><box size="0.06 0.12 0.06"/></geometry><material name="grip_grey"><color rgba="0.25 0.25 0.28 1"/></material></visual>
    <collision><origin xyz="0 0 0.03" rpy="0 0 0"/><geometry><box size="0.06 0.12 0.06"/></geometry></collision>
    <inertial><origin xyz="0 0 0.03" rpy="0 0 0"/><mass value="0.4"/><inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0006"/></inertial>
  </link>
  <joint name="gripper_mount" type="fixed"><parent link="tool0"/><child link="gripper_base"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>

  <!-- fingers - open at y = +-0.050 (center), closing moves each toward the middle; finger half thickness 0.0075; travel 0..0.035 -->
  <link name="left_finger">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.03 0.015 0.07"/></geometry><material name="finger_dark"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.03 0.015 0.07"/></geometry>
      <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/></inertial>
  </link>
  <link name="right_finger">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.03 0.015 0.07"/></geometry><material name="finger_dark2"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.03 0.015 0.07"/></geometry>
      <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
    <inertial><mass value="0.05"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base"/><child link="left_finger"/><origin xyz="0 0.05 0.095" rpy="0 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-0.01" upper="0.035" effort="60" velocity="0.2"/><dynamics damping="1.0" friction="0.2"/>
  </joint>
  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base"/><child link="right_finger"/><origin xyz="0 -0.05 0.095" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-0.01" upper="0.035" effort="60" velocity="0.2"/><dynamics damping="1.0" friction="0.2"/>
  </joint>
  <!-- tool centre point between the finger tips area (used for pose goals) -->
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed"><parent link="gripper_base"/><child link="gripper_tcp"/><origin xyz="0 0 0.105" rpy="0 0 0"/></joint>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <ros><namespace>$(arg ros_namespace)</namespace></ros>
    </plugin>
    <!-- GRASP ASSIST (disclosed) - attaches the red block to the wrist_3_link (the gripper is lumped into it by the fixed-joint reduction) while commanded, via Gazebo DetachableJoint. -->
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>wrist_3_link</parent_link>
      <child_model>red_block</child_model>
      <child_link>block_link</child_link>
      <attach_topic>/objects/red_block/attach</attach_topic>
      <detach_topic>/objects/red_block/detach</detach_topic>
      <output_topic>/objects/red_block/attached</output_topic>
    </plugin>
  </gazebo>

  <!-- ros2_control - the UR joints (same as ur_simulation_gz) + the two finger joints in the same system -->
  <xacro:include filename="$(find ur_description)/urdf/inc/ur_joint_control.xacro" />
  <ros2_control name="$(arg name)" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:ur_joint_control_description tf_prefix="$(arg tf_prefix)"
      initial_positions="${dict(shoulder_pan_joint=0.0,shoulder_lift_joint=-1.57,elbow_joint=1.57,wrist_1_joint=-1.57,wrist_2_joint=-1.57,wrist_3_joint=0.0)}"/>
    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </ros2_control>
</robot>
