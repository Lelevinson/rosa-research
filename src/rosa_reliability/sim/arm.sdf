<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rosa_reliability">
    <physics name="bounded" type="ignored">
      <max_step_size>0.005</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light name="sun" type="directional"><pose>0 0 5 0 0 0</pose><direction>-0.5 0 -1</direction></light>
    <model name="ground"><static>true</static><link name="ground">
      <collision name="floor"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
      <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></visual>
    </link></model>
    <model name="rosa_arm">
      <link name="base"><pose>0 0 0.2 0 0 0</pose>
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <visual name="base"><geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry></visual>
      </link>
      <joint name="anchor" type="fixed"><parent>world</parent><child>base</child></joint>
      <link name="arm"><pose>0.3 0 0.45 0 0 0</pose>
        <inertial><mass>1</mass><inertia><ixx>0.002</ixx><iyy>0.031</iyy><izz>0.031</izz></inertia></inertial>
        <visual name="arm"><geometry><box><size>0.6 0.06 0.06</size></box></geometry>
          <material><diffuse>0.15 0.45 0.9 1</diffuse></material></visual>
        <collision name="arm"><geometry><box><size>0.6 0.06 0.06</size></box></geometry></collision>
      </link>
      <joint name="shoulder" type="revolute">
        <pose relative_to="arm">-0.3 0 0 0 0 0</pose><parent>base</parent><child>arm</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-0.8</lower><upper>0.8</upper><effort>6</effort><velocity>0.6</velocity></limit>
          <dynamics><damping>0.1</damping></dynamics></axis>
      </joint>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>shoulder</joint_name><topic>/rosa_arm/command</topic>
        <p_gain>20</p_gain><i_gain>0</i_gain><d_gain>2</d_gain><cmd_max>6</cmd_max><cmd_min>-6</cmd_min>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint_name>shoulder</joint_name><topic>/rosa_arm/joint_states</topic>
      </plugin>
    </model>
  </world>
</sdf>
